# Copy this file to .env.local and fill in the values shared privately by the team lead.
# Never commit .env.local.
# NEXT_PUBLIC_* variables are sent to the browser. Everything else stays on the server.

# --- Public (safe in the browser; RLS protects the data) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# --- Secret (server only, never prefix with NEXT_PUBLIC_) ---
# Bypasses Row Level Security. Only for server routes (e.g. patient code + PIN login).
# Required by the daily wellbeing worker; never used by the browser or normal session reads.
SUPABASE_SECRET_KEY=

# --- Demo mode (server only) ---
# true = landing page shows the role picker and every page shows the demo banner.
# On in every environment, production included, while all data is fictional.
DEMO_MODE=true
# Passwords of the seeded demo accounts (see README). The picker signs in with them.
DEMO_PASSWORD=
DEMO_PATIENT_PIN=

# Email (post-MVP): Resend
RESEND_API_KEY=
EMAIL_FROM="Closer <hello@example.com>"

# Daily wellbeing reviews and connection prompts. Server-only, fictional data only.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Random server secret for the daily scheduler's Authorization: Bearer header.
CRON_SECRET=
